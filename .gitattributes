# ==============================================================================
# GitHub Linguist Language Configuration
# Memastikan repositori terdeteksi sebagai SQL
# ==============================================================================

# 1. Daftarkan seluruh file SQL sebagai SQL
sql/**/*.sql linguist-detectable=true linguist-language=SQL
*.sql linguist-detectable=true linguist-language=SQL

# 2. Kecualikan file HTML laporan eksekutif
reports/*.html linguist-detectable=false
reports/*.html linguist-documentation=true

# 3. Tandai skrip generator Python sebagai alat pendukung
scripts/*.py linguist-detectable=false
scripts/*.py linguist-vendored=true
