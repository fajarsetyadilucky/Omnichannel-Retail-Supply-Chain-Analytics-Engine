# ==============================================================================
# GitHub Linguist Language Configuration
# Memastikan repositori terdeteksi 100% sebagai proyek SQL / PLpgSQL murni
# ==============================================================================

# 1. Daftarkan seluruh file SQL sebagai bahasa pemrograman utama (PLpgSQL / SQL)
sql/**/*.sql linguist-detectable=true linguist-language=PLpgSQL
*.sql linguist-detectable=true linguist-language=PLpgSQL

# 2. Kecualikan file HTML laporan eksekutif agar tidak mendominasi badge bahasa
reports/*.html linguist-detectable=false
reports/*.html linguist-documentation=true

# 3. Tandai skrip generator Python sebagai alat pendukung (support tooling)
scripts/*.py linguist-detectable=false
scripts/*.py linguist-vendored=true
